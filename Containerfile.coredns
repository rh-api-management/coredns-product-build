FROM registry.redhat.io/ubi9/go-toolset:latest AS builder

WORKDIR /workspace

# Copy the Go Modules manifests
COPY coredns/go.mod go.mod
COPY coredns/go.sum go.sum

# Cache deps before building and copying source so that we don't need to re-download as much
# and so that source changes don't invalidate our downloaded layer
RUN go mod download

# Copy the go source
COPY ./coredns/*.go ./
COPY ./coredns/core/ core/
COPY ./coredns/coremain/ coremain/
COPY ./coredns/plugin/ plugin/
COPY ./coredns/request/ request/
COPY ./coredns/pb/ pb/

# Build CoreDNS with the Kuadrant plugin
RUN GO111MODULE=on go build -o coredns .

FROM registry.redhat.io/ubi9/ubi-minimal:latest
COPY --from=builder /workspace/coredns /usr/bin/coredns

ENTRYPOINT ["/usr/bin/coredns"]

LABEL version="1.2.0" \
      summary="Red Hat CoreDNS Container Image" \
      description="Red Hat CoreDNS is a DNS server that chains plugins" \
      name="coredns" \
      com.redhat.component="Red Hat CoreDNS" \
      io.k8s.display-name="Red Hat CoreDNS" \
      io.k8s.description="CoreDNS is a fast and flexible DNS server" \
      io.openshift.tags="dns,coredns" \
      io.openshift.expose-services="" \
      vendor="Red Hat, Inc."
